{
  "name": "codebase-auditor",
  "version": "0.1.0",
  "description": "Autonomous AI Codebase Auditor — reviews any Git repo like a Staff Engineer and emits explainable findings + verified machine-generated patches.",
  "type": "module",
  "license": "MIT",
  "author": "404ghost.bsp@gmail.com",
  "keywords": [
    "code-review",
    "static-analysis",
    "ai",
    "anthropic",
    "claude",
    "audit",
    "tree-sitter",
    "cli",
    "technical-debt"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "auditor": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "auditor.toml.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/main.ts",
    "auditor": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "commander": "^13.1.0",
    "diff": "^7.0.0",
    "execa": "^9.5.2",
    "globby": "^14.0.2",
    "ignore": "^7.0.3",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1",
    "tree-sitter-wasms": "^0.1.12",
    "web-tree-sitter": "^0.24.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
