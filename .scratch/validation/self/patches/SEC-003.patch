+/**
+ * Splits a shell command string into an argv array respecting single/double
+ * quotes and backslash escapes. Returns null if the command is empty.
+ */
+function parseArgv(cmd: string): [string, ...string[]] | null {
+  const args: string[] = [];
+  let current = "";
+  let inSingle = false;
+  let inDouble = false;
+
+  for (let i = 0; i < cmd.length; i++) {
+    const ch = cmd[i]!;
+    if (ch === "'" && !inDouble) {
+      inSingle = !inSingle;
+    } else if (ch === '"' && !inSingle) {
+      inDouble = !inDouble;
+    } else if (ch === "\\" && !inSingle && i + 1 < cmd.length) {
+      current += cmd[++i]!;
+    } else if (/\s/.test(ch) && !inSingle && !inDouble) {
+      if (current) {
+        args.push(current);
+        current = "";
+      }
+    } else {
+      current += ch;
+    }
+  }
+  if (current) args.push(current);
+
+  const first = args[0];
+  if (!first) return null;
+  return [first, ...args.slice(1)];
+}
